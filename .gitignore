# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Dati e output del simulatore -----------------------------------------
# Rigenerabili: si producono con `python -m plcsim.run`. La taratura di
# ingresso NON sta qui, sta in plcsim/valve_params.csv (ADR-0023).
data/
work/
# Uscita del flow Node-RED: si rigenera a ogni corsa.
edge/out/*.jsonl

# --- Il sito, montato ------------------------------------------------------
# Si rifa' con: python sito/costruisci.py && python sito/viaggio/costruisci.py
#               && python sito/verifica.py && python sito/pubblica.py
# Tenerlo dentro vorrebbe dire avere due volte le stesse pagine.
sito/build/
sito/viaggio/build/
sito/pubblica/

# --- Stato dei servizi al bordo -------------------------------------------
# Volumi e persistenza dei container: stato di esecuzione, non sorgente.
edge/postgres/data/
edge/mosquitto/data/
edge/mosquitto/log/

# --- Sistema operativo ed editor ------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# --- Segreti -------------------------------------------------------------
# Nessuno di questi e' mai esistito nel repository: la riga sta qui perche'
# un file di ambiente si crea per sbaglio, e allora e' tardi.
.env
.env.*
*.pem
*.key

# --- Appunti di lavoro ---------------------------------------------------
# Passaggi di consegne e istruzioni per gli agenti: contengono percorsi
# locali e note personali. Fino a oggi stavano in .git/info/exclude, che pero'
# non viaggia col clone: chi riclona il repository perdeva la protezione, e
# i nomi erano comunque gia' citati in AGENTS.md e PRODUCT.md.
HANDOFF-*.md
CLAUDE.md
CONTEXT-local.md
.scratch/
.agents/
.claude/
.pi-subagents/
skills-lock.json

# --- Materiale di partenza e archivio ------------------------------------
Proposte/
Archive/
feedback/
risposte/

# --- Abbozzo Node mai usato ----------------------------------------------
# `npm init` l'ha creato e nessuno l'ha piu' toccato: questo progetto e'
# Python, e quel file dichiara "license": "ISC", che contraddice LICENSE.
package.json

# --- Rumore --------------------------------------------------------------
*.log
*.tmp
*.bak
node_modules/
